@model IEnumerable<TerraJourn.Models.Entities.Blog>

@{
    ViewBag.Title = "Blog Listesi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>@ViewBag.Title</h2>

<p>
    @Html.ActionLink("Yeni Blog Oluştur", "Create", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Başlık</th>
            <th>Yazar</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.BlogId</td>
                <td>@item.Title</td>
                <td>@(item.User != null ? item.User.UserName : "Bilinmiyor")</td>
                <td>
                    @Html.ActionLink("Düzenle", "Edit", new { id = item.BlogId }, new { @class = "btn btn-warning btn-sm" }) |
                    @Html.ActionLink("Detaylar", "Details", new { id = item.BlogId }, new { @class = "btn btn-info btn-sm" }) |
                    <form action="@Url.Action("Delete", "Blogs", new { id = item.BlogId })" method="post" onsubmit="return confirm('Bu blog yazısını silmek istediğinizden emin misiniz?');" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
