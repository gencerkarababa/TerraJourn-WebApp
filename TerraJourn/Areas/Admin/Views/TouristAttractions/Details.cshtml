@model TerraJourn.Models.Entities.TouristAttraction

@{
    ViewBag.Title = "Mekan Detayları";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>@Model.Name Detayları</h2>
<hr />

<dl class="dl-horizontal">
    <dt>Mekan ID</dt>
    <dd>@Model.TouristAttractionId</dd>

    <dt>Mekan Adı</dt>
    <dd>@Model.Name</dd>

    <dt>Ülke</dt>
    <dd>@Model.Country</dd>

    <dt>Şehir</dt>
    <dd>@Model.City</dd>

    <dt>Adres</dt>
    <dd>@Model.Address</dd>

    <dt>Görsel URL</dt>
    <dd>@Model.ImageUrl</dd>

    <dt>Kategoriler</dt>
    <dd>
        @if (Model.PlaceCategories != null && Model.PlaceCategories.Any())
        {
            <ul class="list-unstyled">
                @foreach (var category in Model.PlaceCategories)
                {
                    <li>@category.Name</li>
                }
            </ul>
        }
        else
        {
            <span>Henüz kategori atanmadı.</span>
        }
    </dd>

    <dt>Açıklama</dt>
    <dd>@Html.Raw(Model.Description)</dd>
</dl>

<hr />
<p>
    @Html.ActionLink("Düzenle", "Edit", new { id = Model.TouristAttractionId }, new { @class = "btn btn-warning" }) |
    @Html.ActionLink("Listeye Geri Dön", "Index", null, new { @class = "btn btn-secondary" })
</p>