@model TerraJourn.Models.Entities.User

@{
    ViewBag.Title = "Kullanıcı Detayları";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <h2>Kullanıcı Detayları</h2>
    <hr />

    <dl class="dl-horizontal">
        <dt>Kullanıcı ID</dt>
        <dd>@Model.UserId</dd>

        <dt>Kullanıcı Adı</dt>
        <dd>@Model.UserName</dd>

        <dt>E-posta</dt>
        <dd>@Model.Email</dd>

        <dt>Rol</dt>
        <dd>@Model.Role</dd>

    </dl>
    <hr />

    <h4>Bu Kullanıcının Blogları</h4>
    @if (Model.Blogs != null && Model.Blogs.Any())
    {
        <ul class="list-group">
            @foreach (var blog in Model.Blogs)
            {
                <li class="list-group-item">
                    <strong>@Html.ActionLink(blog.Title, "Details", "Blogs", new { id = blog.BlogId }, null)</strong>
                    <small class="text-muted">- @blog.CreatedDate.ToString("dd MMMM yyyy")</small>
                </li>
            }
        </ul>
    }
    else
    {
        <p>Bu kullanıcının henüz bir blog yazısı bulunmuyor.</p>
    }

    <h4 class="mt-4">Bu Kullanıcının Yorumları</h4>
    @if (Model.Comments != null && Model.Comments.Any())
    {
        <ul class="list-group">
            @foreach (var comment in Model.Comments)
            {
                <li class="list-group-item">
                    <p class="mb-1">@comment.Text</p>
                    <small class="text-muted"><strong>Blog:</strong> @comment.Blog.Title</small>
                </li>
            }
        </ul>
    }
    else
    {
        <p>Bu kullanıcının henüz bir yorumu bulunmuyor.</p>
    }

    <hr />
    @Html.ActionLink("Listeye Geri Dön", "Index", null, new { @class = "btn btn-secondary" })
</div>