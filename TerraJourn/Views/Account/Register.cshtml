@model TerraJourn.Models.ViewModels.RegisterViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>TerraJourn - Kayıt Ol</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <link href="~/Content/mycss/register.css" rel="stylesheet" />
</head>

<body>
    <div class="padding-all">
        <div class="header">
            <h1>YENİ KULLANICI KAYIT</h1>
        </div>

        <div class="form-container">
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="error-message">
                    @ViewBag.ErrorMessage
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="success-message">
                    @TempData["SuccessMessage"]
                </div>
            }

            @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

            @using (Html.BeginForm("Register", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    @Html.TextBoxFor(m => m.UserName, new { placeholder = "Kullanıcı Adı", @class = "input-field" })
                    @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "field-validation-error" })
                </div>

                <div class="form-group">
                    @Html.TextBoxFor(m => m.Email, new { type = "email", placeholder = "E-posta", @class = "input-field" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
                </div>

                <div class="form-group">
                    @Html.PasswordFor(m => m.Password, new { placeholder = "Şifre", @class = "input-field" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
                </div>

                <div class="form-group">
                    @Html.PasswordFor(m => m.ConfirmPassword, new { placeholder = "Şifre Tekrarı", @class = "input-field" })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-validation-error" })
                </div>

                <button type="submit" class="btn-submit">Kayıt Ol</button>
            }
        </div>
        <div class="footer">
            <p>© 2025 TerraJourn. Tüm hakları saklıdır.</p>
        </div>
    </div>
</body>
</html>
