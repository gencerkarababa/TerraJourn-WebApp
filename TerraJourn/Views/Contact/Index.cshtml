@using TerraJourn.Models.Entities
@model List<ContactInformation>
@{
    ViewBag.Title = "İletişim";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<link href="~/Content/mycss/contact.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

<div class="container pb-5">

    <div class="text-center">
        <h2 class="contact-title">İletişim Bilgilerimiz</h2>
    </div>

    @foreach (var item in Model)
    {
        <div class="contact-card mb-5">
            <div class="row">
                <div class="col-md-5 d-flex flex-column justify-content-center">

                    <div class="info-row">
                        <i class="bi bi-geo-alt-fill"></i>
                        <div>
                            <b>Adresimiz:</b> <br />
                            @item.Address
                        </div>
                    </div>

                    <div class="info-row">
                        <i class="bi bi-envelope-fill"></i>
                        <div>
                            <b>Email:</b> <br />
                            <a href="mailto:@item.Email">@item.Email</a>
                        </div>
                    </div>

                    <div class="info-row">
                        <i class="bi bi-telephone-fill"></i>
                        <div>
                            <b>Telefon:</b> <br />
                            <a href="tel:@item.PhoneNumber">@item.PhoneNumber</a>
                        </div>
                    </div>

                    <div class="mt-4">
                        <a href="#" class="btn-live-support">
                            <i class="bi bi-chat-dots"></i> Canlı Destek
                        </a>
                    </div>

                </div>

                <div class="col-md-7">
                    <div id="map-@item.ContactInfoId" class="map-container"
                         data-lat="@item.Latitude.ToString().Replace(',', '.')"
                         data-lng="@item.Longitude.ToString().Replace(',', '.')">
                    </div>
                </div>
            </div>
        </div>
    }

</div>

<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll('.map-container').forEach(mapDiv => {
            let lat = parseFloat(mapDiv.getAttribute("data-lat").replace(',', '.'));
            let lng = parseFloat(mapDiv.getAttribute("data-lng").replace(',', '.'));

            if (!isNaN(lat) && !isNaN(lng)) {
                let map = L.map(mapDiv.id).setView([lat, lng], 13);

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; TerraJourn'
                }).addTo(map);

                L.marker([lat, lng]).addTo(map)
                    .bindPopup("<b style='color:#001f3f'>TerraJourn Merkez</b><br>" + lat + ", " + lng)
                    .openPopup();
            } else {
                console.error("Hata: Geçersiz koordinat.", lat, lng);
            }
        });
    });
</script>