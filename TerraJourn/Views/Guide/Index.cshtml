@model IEnumerable<TerraJourn.Models.Entities.Question>

@{
    ViewBag.Title = "Akıllı Rota Sihirbazı";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<!-- Projenin genel CSS stiline uyumlu bağlantı -->
<link href="~/Content/mycss/smartroute.css" rel="stylesheet" />

<div class="main-container" style="max-width: 800px; margin: 40px auto; padding: 0 20px;">

    <!-- Üst Başlık Alanı (AboutUs başlık havasında) -->
    <div style="text-align: center; margin-bottom: 40px;">
        <h1 style="font-size: 2.5rem; color: #2c3e50; font-weight: 700; margin-bottom: 10px;">🤖 Akıllı Rota Sihirbazı</h1>
        <p style="color: #7f8c8d; font-size: 1.1rem;">Sana özel en mükemmel seyahat planını oluşturmak için tercihlerini adım adım belirle.</p>
    </div>

    <!-- Sihirbaz Kartı -->
    <div style="background: #ffffff; padding: 40px; border-radius: 16px; box-shadow: 0 8px 30px rgba(0,0,0,0.06); border: 1px solid #eaeaea;">

        @using (Html.BeginForm("SubmitChoices", "Guide", FormMethod.Post, new { id = "wizardForm" }))
        {
            int stepIndex = 0;

            foreach (var question in Model)
            {
                stepIndex++;
                string displayStyle = (stepIndex == 1) ? "block" : "none";

                <div class="wizard-step" data-step="@stepIndex" style="display: @displayStyle;">

                    <!-- Adım Göstergesi ve Soru -->
                    <div style="margin-bottom: 30px;">
                        <span style="display: inline-block; background: #eef2ff; color: #4f46e5; padding: 6px 16px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.5px;">
                            ADIM @stepIndex / 6
                        </span>
                        <h3 style="margin-top: 15px; color: #1e293b; font-size: 1.5rem; font-weight: 600; line-height: 1.4;">
                            @question.QuestionText
                        </h3>
                    </div>

                    <!-- Seçenekler Listesi (Şık Kart Tasarımı) -->
                    <div style="display: flex; flex-direction: column; gap: 14px; margin-bottom: 40px;">
                        @foreach (var option in question.Options)
                        {
                            <label class="option-card" style="display: flex; align-items: center; padding: 18px 22px; border: 2px solid #e2e8f0; border-radius: 12px; cursor: pointer; transition: all 0.25s ease; background: #fafafa;">
                                <input type="checkbox" name="selectedOptions" value="@option.OptionId" style="width: 20px; height: 20px; accent-color: #4f46e5; margin-right: 18px; cursor: pointer;" />
                                <span style="font-size: 1.05rem; color: #334155; font-weight: 500;">@option.OptionText</span>
                            </label>
                        }
                    </div>

                    <!-- Alt Navigasyon Butonları -->
                    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #edf2f7; pt: 25px; margin-top: 25px; padding-top: 25px;">
                        @if (stepIndex > 1)
                        {
                            <button type="button" onclick="changeStep(-1)" style="background: #f1f5f9; color: #475569; border: none; padding: 12px 28px; border-radius: 10px; font-weight: 600; cursor: pointer; transition: background 0.2s;">
                                ⬅ Geri
                            </button>
                        }
                        else
                        {
                            <div></div>
                        }

                        @if (stepIndex < 6)
                        {
                            <button type="button" onclick="changeStep(1)" style="background: #4f46e5; color: white; border: none; padding: 12px 32px; border-radius: 10px; font-weight: 600; cursor: pointer; transition: background 0.2s; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2);">
                                İleri ➡
                            </button>
                        }
                        else
                        {
                            <button type="submit" style="background: #10b981; color: white; border: none; padding: 14px 36px; border-radius: 10px; font-weight: 600; cursor: pointer; font-size: 1.05rem; transition: background 0.2s; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);">
                                Tercihleri Tamamla ✔
                            </button>
                        }
                    </div>

                </div>
            }
        }

    </div>
</div>

<!-- Akıcı Adım Geçiş ve Seçim Efektleri -->
<script>
    let currentStep = 1;

    function changeStep(direction) {
        document.querySelector(`.wizard-step[data-step='${currentStep}']`).style.display = 'none';
        currentStep += direction;
        document.querySelector(`.wizard-step[data-step='${currentStep}']`).style.display = 'block';
        window.scrollTo({ top: 100, behavior: 'smooth' });
    }

    document.querySelectorAll('.option-card').forEach(card => {
        const checkbox = card.querySelector('input[type="checkbox"]');

        card.addEventListener('click', function (e) {
            if (e.target !== checkbox) {
                checkbox.checked = !checkbox.checked;
            }

            if (checkbox.checked) {
                card.style.borderColor = '#4f46e5';
                card.style.background = '#eef2ff33';
                card.style.boxShadow = '0 4px 12px rgba(79, 70, 229, 0.08)';
            } else {
                card.style.borderColor = '#e2e8f0';
                card.style.background = '#fafafa';
                card.style.boxShadow = 'none';
            }
        });
    });
</script>