@model IEnumerable<TerraJourn.Models.Entities.Question>

@{
    ViewBag.Title = "Akıllı Rota Sihirbazı";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<link href="~/Content/mycss/guide.css" rel="stylesheet" />

<div class="guide-wizard-container">
    <div class="wizard-card" style="position: relative; overflow: hidden;">

        @{
            var firstQuestion = Model.FirstOrDefault();
            string initialPhoto = firstQuestion != null ? firstQuestion.PhotoUrl : "";
        }
        <img id="wizardBgImg" src="@initialPhoto" alt="Sihirbaz Arka Planı" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(0.45); z-index: 1;" />

        <div style="position: relative; z-index: 2; height: 100%; display: flex; flex-direction: column; justify-content: space-between;">

            <div class="wizard-header">
                <h2 style="color: #ffffff;">Akıllı Rota Sihirbazı</h2>
                <p style="color: #dfe6e9;">Tercihlerini belirle, hedefe ulaşalım.</p>
            </div>

            @using (Html.BeginForm("SubmitChoices", "Guide", FormMethod.Post, new { id = "wizardForm" }))
            {
                int stepIndex = 0;

                foreach (var question in Model)
                {
                    stepIndex++;
                    string displayStyle = (stepIndex == 1) ? "block" : "none";

                    <div class="wizard-step" data-step="@stepIndex" data-photo="@question.PhotoUrl" style="display: @displayStyle;">

                        <div style="text-align: center;">
                            <span class="step-badge">ADIM @stepIndex / @Model.Count()</span>
                            <h3 class="wizard-question" style="color: #ffffff;">@question.QuestionText</h3>
                        </div>

                        <div class="options-grid">
                            @foreach (var option in question.Options)
                            {
                                <label class="option-card" onclick="toggleCard(this)">
                                    <input type="checkbox" name="selectedOptions" value="@option.OptionId" />
                                    <span>@option.OptionText</span>
                                </label>
                            }
                        </div>

                        <div class="wizard-actions">
                            @if (stepIndex > 1)
                            {
                                <button type="button" class="btn-wizard-prev" onclick="changeStep(-1)">Geri</button>
                            }
                            else
                            {
                                <div></div>
                            }

                            @if (stepIndex < Model.Count())
                            {
                                <button type="button" class="btn-wizard-next" onclick="changeStep(1)">Devam Et</button>
                            }
                            else
                            {
                                <button type="submit" class="btn-wizard-submit">Tamamla ✔</button>
                            }
                        </div>

                    </div>
                }
            }
        </div>

    </div>
</div>

<script>
    let currentStep = 1;

    function changeStep(direction) {
        document.querySelector(`.wizard-step[data-step='${currentStep}']`).style.display = 'none';

        currentStep += direction;

        const nextStepElement = document.querySelector(`.wizard-step[data-step='${currentStep}']`);
        nextStepElement.style.display = 'block';

        const photoUrl = nextStepElement.getAttribute('data-photo');
        if (photoUrl) {
            document.getElementById('wizardBgImg').src = photoUrl;
        }
    }

    function toggleCard(card) {
        const checkbox = card.querySelector('input[type="checkbox"]');

        if (event.target !== checkbox) {
            checkbox.checked = !checkbox.checked;
        }

        if (checkbox.checked) {
            card.classList.add('selected-card');
        } else {
            card.classList.remove('selected-card');
        }
    }
</script>