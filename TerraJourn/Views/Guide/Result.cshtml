@{
    ViewBag.Title = "Önerdiğimiz Seyahat Rotan";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="main-container" style="max-width: 850px; margin: 40px auto; padding: 0 20px;">

    <!-- Üst Bilgi Alanı -->
    <div style="text-align: center; margin-bottom: 35px;">
        <span style="display: inline-block; background: #eef2ff; color: #4f46e5; padding: 6px 16px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.5px; margin-bottom: 12px;">
            ✨ SANA ÖZEL HAZIRLANDI
        </span>
        <h1 style="font-size: 2.3rem; color: #1e293b; font-weight: 700;">Yapay Zeka Rota Önerin</h1>
        <p style="color: #64748b; font-size: 1.05rem; margin-top: 8px;">Seçtiğin tercihlere göre AI rehberliğinde oluşturulan seyahat planın aşağıdadır.</p>
    </div>

    <!-- Rota İçerik Kartı -->
    <div style="background: #ffffff; padding: 40px; border-radius: 16px; box-shadow: 0 8px 30px rgba(0,0,0,0.06); border: 1px solid #eaeaea; line-height: 1.7; color: #334155; font-size: 1.05rem;">

        @if (ViewBag.AiRoute != null)
        {
            <!-- Yapay zekadan gelen düz metni HTML olarak düzgün göstermek veya doğrudan basmak için -->
            <div style="white-space: pre-line;">
                @ViewBag.AiRoute
            </div>
        }
        else
        {
            <div style="text-align: center; color: #ef4444; padding: 20px;">
                <p>Üzgünüz, rota oluşturulurken bir hata oluştu veya yapay zekadan yanıt alınamadı.</p>
            </div>
        }

    </div>

    <!-- Alt Butonlar -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 30px;">
        <a href="@Url.Action("Index", "Guide")" style="background: #f1f5f9; color: #475569; padding: 12px 24px; border-radius: 10px; text-decoration: none; font-weight: 600; transition: background 0.2s;">
            ⬅ Yeniden Rota Oluştur
        </a>

        <button onclick="window.print()" style="background: #4f46e5; color: white; border: none; padding: 12px 24px; border-radius: 10px; font-weight: 600; cursor: pointer; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2);">
            🖨 Rotayı Yazdır / Kaydet
        </button>
    </div>

</div>