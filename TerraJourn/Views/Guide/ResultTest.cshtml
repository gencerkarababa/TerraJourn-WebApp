@{
    ViewBag.Title = "Seçim Testi Sonucu";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="main-container" style="max-width: 700px; margin: 60px auto; padding: 30px; background: #fff; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);">

    <h2 style="color: #10b981; margin-bottom: 20px;">🎉 Tebrikler, Tercihler Başarıyla Alındı!</h2>
    <p style="color: #666; font-size: 1.1rem;">Kullanıcının sihirbazda seçtiği şıkların veritabanındaki karşılıkları:</p>

    <ul style="background: #f8fafc; padding: 20px 20px 20px 40px; border-radius: 8px; border: 1px solid #e2e8f0; margin-top: 20px;">
        @if (ViewBag.SelectedChoices != null)
        {
            foreach (var choice in ViewBag.SelectedChoices)
            {
                <li style="font-size: 1.1rem; color: #334155; margin-bottom: 8px; font-weight: 500;">
                    @choice
                </li>
            }
        }
        else
        {
            <li style="color: #ef4444;">Hiçbir seçim alınamadı veya liste boş.</li>
        }
    </ul>

    <div style="margin-top: 30px;">
        <a href="@Url.Action("Index", "Guide")" style="background: #4f46e5; color: white; padding: 10px 20px; border-radius: 8px; text-decoration: none; font-weight: 600;">
            ⬅ Sihirbaza Geri Dön
        </a>
    </div>

</div>