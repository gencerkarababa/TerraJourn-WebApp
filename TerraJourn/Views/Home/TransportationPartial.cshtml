@model object

<h2 class="section-title">Ulaşım & Biletler</h2>

<div class="promo-card" style="background: #ffffff; border-radius: 12px; padding: 25px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); border: 1px solid #eaeaea; display: flex; flex-direction: column; justify-content: space-between; height: 100%;">
    <div>
        <span class="promo-badge" style="background: #eef2ff; color: #001f3f; padding: 4px 12px; border-radius: 15px; font-size: 0.75rem; font-weight: bold; text-transform: uppercase;">Ulaşım Ağı</span>
        <h3 style="font-size: 1.3rem; color: #001f3f; margin: 12px 0 8px 0; font-weight: bold;">✈️ Uçak & Otobüs Seferleri</h3>
        <p style="color: #636e72; font-size: 0.9rem; line-height: 1.5; margin-bottom: 20px;">Seyahat rotan için en uygun uçak ve otobüs biletlerini karşılaştır, yolculuğunu güvenle planla.</p>
    </div>
    <div>
        <a href="https://www.skyscanner.com.tr" target="_blank" class="promo-btn" style="display: block; text-align: center; background: #001f3f; color: #fff; padding: 12px; border-radius: 8px; font-weight: bold; font-size: 0.95rem; text-decoration: none; transition: background 0.2s;">Biletleri Karşılaştır →</a>
    </div>
</div>