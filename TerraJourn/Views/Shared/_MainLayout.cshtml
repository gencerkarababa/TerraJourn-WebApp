@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TerraJourn - @ViewBag.Title</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="~/Content/mycss/mainlayout.css" rel="stylesheet" />

    @RenderSection("Styles", required: false)
</head>
<body>

    <header>
        <div class="navbar-container">
            <div class="logo">
                <a href="/Home/Index/">
                    <img src="~/Images/te_j_y.png" alt="TerraJourn Logo" />
                </a>
            </div>

            <ul class="nav-menu">
                <li><a href="/Home/Index/">Ana Sayfa</a></li>
                <li><a href="/Blog/Index/">Bloglar</a></li>
                <li><a href="/Guide/Index/">Rehber</a></li>
                <li><a href="/About/Index/">Hakkımızda</a></li>
                <li><a href="/Contact/Index/">İletişim</a></li>
            </ul>

            <div class="nav-right">
                @if (Session["UserName"] != null)
                {
                    <a href="@Url.Action("Index", "Profile", new { area = "Member" })" class="user-profile">
                        <img src="~/Images/avatar.png" alt="Profil" class="user-avatar">
                        <span class="user-name">@Session["UserName"]</span>
                    </a>
                }
                
                <div class="hamburger">
                    <i class="bi bi-list"></i>
                </div>
            </div>
        </div>
    </header>

    <main class="main-content">
        @RenderBody()
    </main>

    <footer>
        <div class="footer-container">
            <p>&copy; @DateTime.Now.Year TerraJourn. Tüm Hakları Saklıdır.</p>
        </div>
    </footer>

    <script src="~/Scripts/jquery-3.4.1.min.js"></script> @RenderSection("Scripts", required: false)

</body>
</html>